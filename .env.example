# ------------------------------------------------------------------
# Brobond AI Commerce OS — Environment Variables
# Copy this file to `.env` and fill in the values.
#
# ENVIRONMENT CONTRACT
# Core runtime: AUTH_SECRET · NEXTAUTH_URL · APP_URL · DATABASE_URL ·
# AUTH_TRUST_HOST.
# Optional federated sign-in: AUTH_GOOGLE_ID · AUTH_GOOGLE_SECRET (or the
# PR010.3 aliases GOOGLE_CLIENT_ID · GOOGLE_CLIENT_SECRET).
# Optional integrations (such as TikTok Shop below) are read only by their
# server-only modules when an operator enables that integration.
#
# SECURITY: AUTH_SECRET and DATABASE_URL are server-only. They must never be
# exposed to client components (no `NEXT_PUBLIC_` prefix, ever).
# ------------------------------------------------------------------

# --- NextAuth v5 ---------------------------------------------------
# Signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Canonical deployment URL used by NextAuth for callbacks/redirects.
NEXTAUTH_URL=http://localhost:3000
# Trust the reverse-proxy Host header (required on Render / behind Docker).
AUTH_TRUST_HOST=true

# --- Canonical public URL (PR010.3 §12) -----------------------------
# Base URL used to build links handed to humans — invitation links today.
# Takes precedence over NEXTAUTH_URL for link building; NextAuth itself keeps
# using NEXTAUTH_URL for OAuth callbacks. Optional: when unset, invitation
# links fall back to NEXTAUTH_URL.
APP_URL=http://localhost:3000

# --- Google SSO (PR010.2 §4 · PR010.3 §5/§12) — OPTIONAL ------------
# Two equivalent conventions — set ONE complete pair, never a mix:
#   AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET       (NextAuth v5 native)
#   GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET   (PR010.3 alias)
# When a complete pair is set the provider is registered and the "Continuar
# com Google" button appears on /login; when no complete pair exists the
# button is HIDDEN ENTIRELY (never rendered disabled).
#
# Create an OAuth 2.0 Client ID (console.cloud.google.com > APIs & Services >
# Credentials), type "Web application", and add the authorized redirect URI:
#   ${NEXTAUTH_URL}/api/auth/callback/google
#
# SERVER ONLY — never prefix with NEXT_PUBLIC_. The login page receives one
# boolean, never these values.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (PostgreSQL) ----------------------------------------
# Local docker-compose default. Change for production (Render, etc).
DATABASE_URL="postgresql://brobond:brobond@localhost:5432/brobond?schema=public"

# --- Optional -------------------------------------------------------
# NODE_ENV=development

# --- Local seed bootstrap (development only) ------------------------
# Public signup provisions a separate Organization + ADMIN account. The seed
# is optional and only bootstraps the local `brobond` Organization. If
# SEED_ADMIN_PASSWORD is unset, the seed creates the user WITHOUT a password
# (login disabled) instead of inventing one.
# SEED_ADMIN_EMAIL=admin@brobond.ai
# SEED_ADMIN_PASSWORD=

# --- OpenAI / AI Personalization Engine (PR007) ---------------------
# Server-only. Used exclusively by modules/ai/openai/client.ts via the
# OpenAI Responses API. NEVER prefix with NEXT_PUBLIC_ and never import
# the client from a Client Component (enforced by eslint.config.mjs).
# Required only to actually call OpenAI — the dashboard, cache, and tests
# all work without it (tests mock the client entirely).
OPENAI_API_KEY=

# ------------------------------------------------------------------
# TikTok Shop Connector (PR009) — official API, server-side only
# ------------------------------------------------------------------
# Create an OAuth app in TikTok Shop Partner Center and configure its redirect
# URL as ${NEXTAUTH_URL}/api/tiktok/callback (or set TIKTOK_REDIRECT_URI).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Exactly 32 random bytes encoded as base64/base64url (or 64 hex chars).
# Generate: openssl rand -base64 32
TIKTOK_ENCRYPTION_KEY=
# Optional operational overrides (not required for normal production use):
# TIKTOK_REDIRECT_URI=https://app.example.com/api/tiktok/callback
# TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
# TIKTOK_SELLER_AUTH_URL=https://services.tiktokshop.com/open/authorize

# ------------------------------------------------------------------
# Omnichannel Delivery Engine (PR010) — official Meta APIs, server-side only
# ------------------------------------------------------------------
# Create a Meta App (developers.facebook.com) with Instagram Business
# Messaging and the WhatsApp Business Cloud API products, then configure
# the OAuth redirect URLs as:
#   ${NEXTAUTH_URL}/api/instagram/callback
#   ${NEXTAUTH_URL}/api/whatsapp/callback
# and the webhooks:
#   ${NEXTAUTH_URL}/api/webhooks/instagram  (verify token below)
#   ${NEXTAUTH_URL}/api/webhooks/whatsapp   (verify token below)
META_APP_ID=
META_APP_SECRET=
# Random string you invent; Meta must send it back in the webhook GET
# handshake. Generate: openssl rand -base64 32
META_VERIFY_TOKEN=
# Exactly 32 random bytes encoded as base64/base64url (or 64 hex chars) —
# encrypts every Meta access token at rest (AES-256-GCM). NEVER commit a
# real value and NEVER prefix any of these with NEXT_PUBLIC_.
# Generate: openssl rand -base64 32
META_ENCRYPTION_KEY=
# The registered WhatsApp Cloud API sender (Phone Number ID from the Meta
# App's WhatsApp > API Setup panel).
WHATSAPP_PHONE_NUMBER_ID=
# Optional operational overrides (not required for normal production use):
# META_GRAPH_API_BASE_URL=https://graph.facebook.com
# META_GRAPH_API_VERSION=v21.0
# META_OAUTH_AUTHORIZE_BASE_URL=https://www.facebook.com
# META_INSTAGRAM_REDIRECT_URI=https://app.example.com/api/instagram/callback
# META_WHATSAPP_REDIRECT_URI=https://app.example.com/api/whatsapp/callback

# --- Analytics Pipeline (PR006) — NOT IMPLEMENTED -----------------
# ANALYTICS_WRITE_KEY=
