# ------------------------------------------------------------------
# Brobond AI Commerce OS — Environment Variables
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# --- Application ---------------------------------------------------
NODE_ENV=development
APP_NAME="Brobond AI Commerce OS"
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ----------------------------------------
# Local docker-compose default. Change for production (Render, etc).
DATABASE_URL="postgresql://brobond:brobond@localhost:5432/brobond?schema=public"

# --- NextAuth v5 ---------------------------------------------------
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL=http://localhost:3000
# Canonical deployment URL used by NextAuth for callbacks/redirects.
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- OAuth Providers (optional, wire up in lib/auth.ts) -----------
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ------------------------------------------------------------------
# The keys below are RESERVED for future PRs. They are intentionally
# NOT implemented in PR000 — only the architecture is prepared.
# ------------------------------------------------------------------

# --- TikTok API (PR002 / PR004) — NOT IMPLEMENTED -----------------
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=

# --- OpenAI / AI Providers (PR003) — NOT IMPLEMENTED --------------
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- Analytics Pipeline (PR006) — NOT IMPLEMENTED -----------------
# ANALYTICS_WRITE_KEY=
