# ------------------------------------------------------------------
# Brobond AI Commerce OS — Environment Variables
# Copy this file to `.env` and fill in the values.
#
# ENVIRONMENT CONTRACT
# Core runtime: AUTH_SECRET · NEXTAUTH_URL · APP_URL · DATABASE_URL ·
# AUTH_TRUST_HOST.
# Optional federated sign-in: AUTH_GOOGLE_ID · AUTH_GOOGLE_SECRET (or the
# PR010.3 aliases GOOGLE_CLIENT_ID · GOOGLE_CLIENT_SECRET).
# Optional integrations (such as TikTok Shop below) are read only by their
# server-only modules when an operator enables that integration.
#
# SECURITY: AUTH_SECRET and DATABASE_URL are server-only. They must never be
# exposed to client components (no `NEXT_PUBLIC_` prefix, ever).
# ------------------------------------------------------------------

# --- NextAuth v5 ---------------------------------------------------
# Signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Canonical deployment URL used by NextAuth for callbacks/redirects.
NEXTAUTH_URL=http://localhost:3000
# Trust the reverse-proxy Host header (required on Render / behind Docker).
AUTH_TRUST_HOST=true

# --- Canonical public URL (PR010.3 §12) -----------------------------
# Base URL used to build links handed to humans — invitation links today.
# Takes precedence over NEXTAUTH_URL for link building; NextAuth itself keeps
# using NEXTAUTH_URL for OAuth callbacks. Optional: when unset, invitation
# links fall back to NEXTAUTH_URL.
APP_URL=http://localhost:3000

# --- Google SSO (PR010.2 §4 · PR010.3 §5/§12) — OPTIONAL ------------
# Two equivalent conventions — set ONE complete pair, never a mix:
#   AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET       (NextAuth v5 native)
#   GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET   (PR010.3 alias)
# When a complete pair is set the provider is registered and the "Continuar
# com Google" button appears on /login; when no complete pair exists the
# button is HIDDEN ENTIRELY (never rendered disabled).
#
# Create an OAuth 2.0 Client ID (console.cloud.google.com > APIs & Services >
# Credentials), type "Web application", and add the authorized redirect URI:
#   ${NEXTAUTH_URL}/api/auth/callback/google
#
# SERVER ONLY — never prefix with NEXT_PUBLIC_. The login page receives one
# boolean, never these values.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (PostgreSQL) ----------------------------------------
# Local docker-compose default. Change for production (Render, etc).
DATABASE_URL="postgresql://brobond:brobond@localhost:5432/brobond?schema=public"
# Optional pg-pool controls. Render sets conservative production values in
# render.yaml; local development can keep the driver defaults.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Observability (optional; server-side) -------------------------
# Error reporting is disabled unless a Sentry DSN is configured. Sentry DSNs
# identify an ingestion project but are not authentication credentials.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
#
# Tracing export is disabled unless this endpoint is configured. Use an OTLP
# HTTP endpoint from your observability provider; startup remains local-only
# when it is absent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=brobond-ai-commerce
# Set this to a deploy tag or Git SHA in production.
OTEL_SERVICE_VERSION=

# --- Payments / Checkout -------------------------------------------
# Choose the provider used for commerce checkout. 'mock' keeps local testing
# without external network calls; 'stripe' creates real checkout sessions.
PAYMENT_PROVIDER=mock
# When PAYMENT_PROVIDER=stripe, both values are required for a real checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------
# NODE_ENV=development

# --- Durable asynchronous worker (BullMQ + Redis) -------------------
# Optional for the Next.js web process. REQUIRED for `npm run worker`; without
# it, enqueueing and worker readiness fail explicitly instead of using memory.
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=brobond
# QUEUE_CONCURRENCY=5

# --- Governed AI autonomy --------------------------------------------
# Global kill switch. Keep false until an operator explicitly enables governed
# execution. AI CEO remains advisory and never performs external effects.
AI_AUTONOMY_ENABLED=false
# Per-run and rolling per-organization budgets, in integer cents.
AI_ORG_RUN_BUDGET_CENTS=100
AI_ORG_PERIOD_BUDGET_CENTS=1000
AI_BUDGET_PERIOD_HOURS=24

# --- Local seed bootstrap (development only) ------------------------
# Public signup provisions a separate Organization + ADMIN account. The seed
# is optional and only bootstraps the local `brobond` Organization. If
# SEED_ADMIN_PASSWORD is unset, the seed creates the user WITHOUT a password
# (login disabled) instead of inventing one.
# SEED_ADMIN_EMAIL=admin@brobond.ai
# SEED_ADMIN_PASSWORD=

# --- OpenAI / AI Personalization + AI CEO (PR007 / PR011) -----------
# Server-only. Used exclusively through modules/ai/openai/client.ts via the
# OpenAI Responses API. The PR011 AI CEO reuses that client with versioned
# prompts and a fixed 0.3 temperature. NEVER prefix with NEXT_PUBLIC_ and
# never import the client from a Client Component (enforced by eslint).
# Required only to generate AI content/decisions/reports — read dashboards,
# persisted audit data and tests work without it (tests mock the client).
OPENAI_API_KEY=

# --- Transactional invitation email --------------------------------
# Required to send workspace invitations. The raw invitation URL is a
# single-use bearer credential and is never written to application logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Brobond <convites@example.com>"

# ------------------------------------------------------------------
# TikTok Shop Connector (PR009) — official API, server-side only
# ------------------------------------------------------------------
# Create an OAuth app in TikTok Shop Partner Center and configure its redirect
# URL as ${NEXTAUTH_URL}/api/tiktok/callback (or set TIKTOK_REDIRECT_URI).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Exactly 32 random bytes encoded as base64/base64url (or 64 hex chars).
# Generate: openssl rand -base64 32
TIKTOK_ENCRYPTION_KEY=
# Optional operational overrides (not required for normal production use):
# TIKTOK_REDIRECT_URI=https://app.example.com/api/tiktok/callback
# TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
# TIKTOK_SELLER_AUTH_URL=https://services.tiktokshop.com/open/authorize

# ------------------------------------------------------------------
# Omnichannel Delivery Engine (PR010) — official Meta APIs, server-side only
# ------------------------------------------------------------------
# Create a Meta App (developers.facebook.com) with Instagram Business
# Messaging and the WhatsApp Business Cloud API products, then configure
# the OAuth redirect URLs as:
#   ${NEXTAUTH_URL}/api/instagram/callback
#   ${NEXTAUTH_URL}/api/whatsapp/callback
# and the webhooks:
#   ${NEXTAUTH_URL}/api/webhooks/instagram  (verify token below)
#   ${NEXTAUTH_URL}/api/webhooks/whatsapp   (verify token below)
META_APP_ID=
META_APP_SECRET=
# Random string you invent; Meta must send it back in the webhook GET
# handshake. Generate: openssl rand -base64 32
META_VERIFY_TOKEN=
# Exactly 32 random bytes encoded as base64/base64url (or 64 hex chars) —
# encrypts every Meta access token at rest (AES-256-GCM). NEVER commit a
# real value and NEVER prefix any of these with NEXT_PUBLIC_.
# Generate: openssl rand -base64 32
META_ENCRYPTION_KEY=
# The registered WhatsApp Cloud API sender (Phone Number ID from the Meta
# App's WhatsApp > API Setup panel).
WHATSAPP_PHONE_NUMBER_ID=
# Optional operational overrides (not required for normal production use):
# META_GRAPH_API_BASE_URL=https://graph.facebook.com
# META_GRAPH_API_VERSION=v21.0
# META_OAUTH_AUTHORIZE_BASE_URL=https://www.facebook.com
# META_INSTAGRAM_REDIRECT_URI=https://app.example.com/api/instagram/callback
# META_WHATSAPP_REDIRECT_URI=https://app.example.com/api/whatsapp/callback

# ------------------------------------------------------------------
# Real Marketplace Integrations (PR012) — official APIs, server-side only
# ------------------------------------------------------------------
# Exactly 32 random bytes (base64/base64url or 64 hex chars) — encrypts every
# unified Connector credential at rest (AES-256-GCM): Shopee / Mercado Livre
# OAuth tokens and the Mercado Pago Access Token / Public Key.
# Generate: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# --- Shopee Open Platform v2 ---------------------------------------
# Partner Center (open.shopee.com) → App Management. Configure the redirect
# URL as ${NEXTAUTH_URL}/api/shopee/callback (or set SHOPEE_REDIRECT_URI)
# and the webhook (push) URL as ${NEXTAUTH_URL}/api/webhooks/shopee.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Optional operational overrides (not required for normal production use):
# SHOPEE_REDIRECT_URI=https://app.example.com/api/shopee/callback
# SHOPEE_API_BASE_URL=https://partner.shopeemobile.com

# --- Mercado Livre (Meli API) --------------------------------------
# DevCenter (developers.mercadolivre.com.br) → your application. Configure
# the redirect URL as ${APP_URL}/api/mercadolivre/callback and the
# webhook as ${APP_URL}/api/webhooks/mercadolivre?secret=<MERCADOLIVRE_WEBHOOK_SECRET>
#
# REDIRECT URI — the #1 cause of "Não foi possível listar os anúncios".
# Meli validates `redirect_uri` twice (authorization AND code exchange) and
# the two must be byte-identical to the URI registered in DevCenter. The
# server resolves it in this order:
#   MERCADOLIVRE_REDIRECT_URI → APP_URL → NEXTAUTH_URL → the callback
#   request's own public URL (X-Forwarded-Host behind Render's proxy).
# So: set APP_URL to the exact public address of the deployment (no trailing
# slash, same host as DevCenter) and nothing else is needed. If the exchange
# is still refused, the rejected candidates are printed in the server log
# under [mercadolivre.oauth.callback] — register one of them in DevCenter.
# `/api/connectors/mercadolivre/callback` is accepted as an alias of the
# canonical path, for applications registered under that namespace.
#
# PKCE (PR016.2) — unified-DevCenter applications (Mercado Livre + Mercado
# Pago in the same app) ship with the PKCE flow ENABLED, and with it Meli
# makes code_challenge/code_verifier MANDATORY; without them the token
# exchange dies with `invalid_request: "code_verifier is a required
# parameter"`. The connector now runs the full S256 flow automatically:
# a 384-bit code_verifier is issued with every one-time OAuth state, kept
# encrypted at rest (AES-256-GCM under CONNECTOR_ENCRYPTION_KEY, in the
# ConnectorOAuthState table) and replayed on the exchange. No configuration
# is required — it is also tolerated by applications WITHOUT the flag.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Optional operational overrides (not required for normal production use):
# MERCADOLIVRE_REDIRECT_URI=https://app.example.com/api/mercadolivre/callback
# MERCADOLIVRE_AUTH_BASE_URL=https://auth.mercadolivre.com.br
# MERCADOLIVRE_API_BASE_URL=https://api.mercadolibre.com
# Random string you invent; required in the registered webhook URL query.
# Generate: openssl rand -base64 32
# MERCADOLIVRE_WEBHOOK_SECRET=

# PR014 — Motor Financeiro: `orders` / `orders_v2` notifications are
# ingested by the webhook above and processed in the background by the
# BullMQ/Redis worker (`npm run worker`), which refreshes the access token
# with MERCADOLIVRE_CLIENT_SECRET, fetches the authoritative order and
# upserts the tenant's Sale (channel MERCADOLIVRE, externalOrderId, BRL
# cents) idempotently. No extra variables are required.

# --- Mercado Pago ----------------------------------------------------
# Preferred: enter the seller's production credentials in the dashboard
# (Conectores → Mercado Pago), where they are encrypted in Connector.
# Optional Render fallback: configure BOTH variables below. Their values stay
# server-side; `/api/connectors/status` exposes only connected state, metrics
# and a masked Public Key preview. A partial pair is treated as disconnected.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Webhook URL: ${NEXTAUTH_URL}/api/webhooks/mercadopago
# Webhook signature secret from the Mercado Pago webhooks panel; when set,
# every inbound event is HMAC-verified (x-signature header).
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com

# PR014 — Motor Financeiro: approved `payment` notifications are ingested
# by the webhook above and processed in the background by the BullMQ/Redis
# worker (`npm run worker`), which fetches the authoritative payment with
# MERCADOPAGO_ACCESS_TOKEN (or the tenant's encrypted credential) and
# upserts the tenant's Sale (channel MERCADOPAGO, externalOrderId, BRL
# cents) idempotently. The worker reuses the async REDIS_URL below.

# --- Analytics Pipeline (PR006) — NOT IMPLEMENTED -----------------
# ANALYTICS_WRITE_KEY=
