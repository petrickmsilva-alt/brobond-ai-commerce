// ------------------------------------------------------------------
// Brobond AI Commerce OS — Prisma Schema
// PR000 Bootstrap Foundation
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  // Uses the pg driver adapter (see lib/prisma.ts) — GA since Prisma 6.16,
  // so no preview feature flag is required.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CreatorStatus {
  PROSPECT
  INVITED
  ACTIVE
  PAUSED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  SYSTEM
  EMAIL
  DM
  SMS
}

enum SaleStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

// ------------------------------------------------------------------
// Tenancy
// ------------------------------------------------------------------

// Organization is the top-level tenant boundary. Every domain record
// (users, products, creators, campaigns) belongs to exactly one
// Organization, enabling multi-tenant data isolation.
model Organization {
  id     String @id @default(cuid())
  name   String
  slug   String @unique

  // Tenant-scoped relations
  users     User[]
  products  Product[]
  creators  Creator[]
  campaigns Campaign[]

  productMedia    ProductMedia[]
  productVariants ProductVariant[]
  productCosts    ProductCost[]
  productMetrics  ProductMetric[]

  trendSnapshots  TrendSnapshot[]
  trendKeywords   TrendKeyword[]
  trendCategories TrendCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ------------------------------------------------------------------
// Core Models
// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(MEMBER)
  emailVerified DateTime?

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // NextAuth relations (adapter-ready)
  accounts Account[]
  sessions Session[]

  // Domain relations
  campaigns Campaign[] @relation("CampaignOwner")
  messages  Message[]  @relation("MessageAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([organizationId])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String
  description String?
  sku         String?
  priceCents  Int           @default(0)
  currency    String        @default("BRL")
  imageUrl    String?
  status      ProductStatus @default(DRAFT)

  /** Aggregate stock on hand (variant stock is tracked per ProductVariant). */
  stockQuantity Int @default(0)

  // Denormalized pricing snapshot — kept in sync by modules/commerce/products/pricing.
  // `currentCostCents` mirrors the latest ProductCost total; `marginBps` is the
  // gross margin in basis points (e.g. 3550 = 35.50%). Denormalized so the
  // dashboard can sort/filter by margin at the database level.
  currentCostCents Int @default(0)
  marginBps        Int @default(0)

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  media    ProductMedia[]
  variants ProductVariant[]
  costs    ProductCost[]
  metrics  ProductMetric[]

  campaigns CampaignProduct[]
  sales     Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant-scoped uniqueness: two organizations may reuse the same slug/SKU.
  @@unique([organizationId, slug])
  @@unique([organizationId, sku])
  @@index([status])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, marginBps])
  @@index([organizationId, priceCents])
}

/// Media asset (image/video) attached to a product. Upload flow is interface-
/// prepared: `url` may point to any storage provider (PR00X wires the real
/// uploader behind modules/commerce/products/services/media-storage.ts).
model ProductMedia {
  id       String           @id @default(cuid())
  type     ProductMediaType @default(IMAGE)
  url      String
  altText  String?
  position Int              @default(0)
  /** Exactly one primary media per product is enforced at the service layer. */
  isPrimary Boolean         @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tenant — REQUIRED (denormalized for direct scoped queries).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([organizationId])
}

/// Sellable variation of a product (size, color, bundle…).
model ProductVariant {
  id         String  @id @default(cuid())
  name       String
  sku        String?
  /** Override price. `null` inherits the parent product price. */
  priceCents Int?
  /** Override unit cost. `null` inherits the product's current cost. */
  costCents  Int?
  stockQuantity Int  @default(0)
  isActive   Boolean @default(true)
  position   Int     @default(0)
  /** Free-form option map, e.g. { "size": "M", "color": "black" }. */
  attributes Json?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tenant — REQUIRED (denormalized for direct scoped queries).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId])
}

/// Cost snapshot for a product. The most recent record (by `effectiveFrom`)
/// is the product's current cost; history is preserved for future analytics.
model ProductCost {
  id             String @id @default(cuid())
  /** Unit acquisition/production cost. */
  unitCents      Int    @default(0)
  /** Inbound freight per unit. */
  freightCents   Int    @default(0)
  /** Packaging per unit. */
  packagingCents Int    @default(0)
  /** Marketplace/platform fees per unit. */
  feesCents      Int    @default(0)
  /** Anything else per unit. */
  otherCents     Int    @default(0)
  currency       String @default("BRL")
  note           String?
  effectiveFrom  DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tenant — REQUIRED (denormalized for direct scoped queries).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, effectiveFrom])
  @@index([organizationId])
}

/// Daily performance metrics per product (views, clicks, conversions, revenue).
model ProductMetric {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  views        Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  unitsSold    Int      @default(0)
  revenueCents Int      @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tenant — REQUIRED (denormalized for direct scoped queries).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
  @@index([organizationId, date])
}

model Creator {
  id          String        @id @default(cuid())
  handle      String        @unique
  displayName String
  email       String?       @unique
  avatarUrl   String?
  bio         String?
  followers   Int           @default(0)
  status      CreatorStatus @default(PROSPECT)

  // Reserved for future TikTok integration (PR002/PR004) — NOT implemented here.
  externalId String? @unique

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaigns CampaignCreator[]
  messages  Message[]         @relation("MessageCreator")
  sales     Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  status      CampaignStatus @default(DRAFT)
  budgetCents Int            @default(0)
  currency    String         @default("BRL")
  startsAt    DateTime?
  endsAt      DateTime?

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  products CampaignProduct[]
  creators CampaignCreator[]
  messages Message[]
  sales    Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([organizationId])
}

model Message {
  id        String           @id @default(cuid())
  body      String
  direction MessageDirection @default(OUTBOUND)
  channel   MessageChannel   @default(SYSTEM)
  readAt    DateTime?

  authorId String?
  author   User?   @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   Creator? @relation("MessageCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([creatorId])
  @@index([authorId])
}

model Sale {
  id          String     @id @default(cuid())
  reference   String     @unique @default(cuid())
  quantity    Int        @default(1)
  amountCents Int        @default(0)
  currency    String     @default("BRL")
  status      SaleStatus @default(PENDING)
  occurredAt  DateTime   @default(now())

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@index([creatorId])
  @@index([campaignId])
}

// ------------------------------------------------------------------
// Trend Hunter AI (PR002)
// ------------------------------------------------------------------

/// Daily trend snapshot produced by the Trend Hunter pipeline
/// (`modules/trends`). One row per keyword per collection run — history is
/// preserved so scores can be trended over time.
///
/// NO external API is wired in PR002: the collector ships a mock source
/// (`modules/trends/hunter/collector.ts`). A real provider (TikTok API,
/// scraping) plugs in behind the `TrendCollector` interface in a future PR.
model TrendSnapshot {
  id         String @id @default(cuid())
  keyword    String
  category   String
  views      Int    @default(0)
  likes      Int    @default(0)
  shares     Int    @default(0)
  /** Weighted 0–100 score from `modules/trends/hunter/scorer.ts`. */
  trendScore Int    @default(0)

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, trendScore])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
}

/// Aggregated keyword frequency across collection runs (tenant-scoped
/// unique: two organizations may track the same keyword independently).
model TrendKeyword {
  id        String @id @default(cuid())
  keyword   String
  /** How many times the keyword has been seen across collection runs. */
  frequency Int    @default(1)

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, keyword])
  @@index([organizationId, frequency])
}

/// Materialized per-category score (average of the latest collection run)
/// powering the dashboard KPI cards and the category filter.
model TrendCategory {
  id    String @id @default(cuid())
  name  String
  score Int    @default(0)

  // Tenant — REQUIRED. No domain record may exist without an Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, score])
}

// ------------------------------------------------------------------
// Join Tables (many-to-many)
// ------------------------------------------------------------------

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([campaignId, productId])
  @@index([productId])
}

model CampaignCreator {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([campaignId, creatorId])
  @@index([creatorId])
}

// ------------------------------------------------------------------
// NextAuth v5 Adapter Models (Prisma adapter compatible)
// ------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
